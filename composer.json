{
  "name": "a-gautrot/propel-bundle",
  "description": "Integration of Propel in Symfony",
  "type": "symfony-bundle",
  "license": "MIT",
  "keywords": [
    "propel",
    "orm",
    "persistence"
  ],
  "authors": [
    {
      "name": "William Durand",
      "email": "william.durand1@gmail.com",
      "role": "Author"
    },
    {
      "name": "SkyFoxvn",
      "role": "Maintenance"
    },
    {
      "name": "Alexandre Gautrot",
      "email": "alexandre.gautrot@etik.com",
      "role": "Maintenance"
    }
  ],
  "autoload": {
    "psr-4": {
      "Propel\\Bundle\\PropelBundle\\": ""
    },
    "classmap": [
      "AppBundle.php"
    ],
    "exclude-from-classmap": [
      "Tests/"
    ]
  },
  "require": {
    "php": ">=8.1",
    "ext-pdo": "*",
    "ext-simplexml": "*",
    "propel/propel": "~2.0",
    "psr/log": "^3.0",
    "symfony/config": "^6.4",
    "symfony/console": "^6.4",
    "symfony/dependency-injection": "^6.4",
    "symfony/framework-bundle": "^6.4",
    "symfony/http-foundation": "^6.4",
    "symfony/http-kernel": "^6.4",
    "symfony/polyfill-php82": "^1.33",
    "symfony/polyfill-php83": "^1.33",
    "symfony/polyfill-php84": "^1.33",
    "symfony/polyfill-php85": "^1.33",
    "symfony/security-bundle": "^6.4",
    "symfony/security-core": "^6.4",
    "symfony/validator": "^6.4",
    "symfony/yaml": "^6.4"
  },
  "conflict": {
    "symfony/cache": "<6.4.40||>=7.0",
    "symfony/clock": "<6.4||>=7.0",
    "symfony/error-handler": "<6.4||>=7.0",
    "symfony/event-dispatcher": "<6.4||>=7.0",
    "symfony/filesystem": "<6.4||>=7.0",
    "symfony/finder": "<6.4||>=7.0",
    "symfony/options-resolver": "<6.4||>=7.0",
    "symfony/password-hasher": "<6.4||>=7.0",
    "symfony/property-access": "<6.4||>=7.0",
    "symfony/property-info": "<6.4||>=7.0",
    "symfony/routing": "<6.4.41||>=7.0",
    "symfony/security-csrf": "<6.4||>=7.0",
    "symfony/security-http": "<6.4.41||>=7.0",
    "symfony/string": "<6.4||>=7.0",
    "symfony/translation": "<6.4.3||>=7.0",
    "symfony/twig-bridge": "<6.4||>=7.0",
    "symfony/twig-bundle": "<6.4||>=7.0",
    "symfony/var-dumper": "<6.4||>=7.0",
    "symfony/var-exporter": "<6.4||>=7.0"
  },
  "require-dev": {
    "ext-dom": "*",
    "ext-libxml": "*",
    "ext-pdo_sqlite": "*",
    "fakerphp/faker": "^1.24",
    "mikey179/vfsstream": "^1.6.12",
    "phpstan/extension-installer": "^1.4",
    "phpstan/phpstan": "^2.0",
    "phpstan/phpstan-deprecation-rules": "^2.0",
    "phpstan/phpstan-symfony": "^2.0",
    "phpunit/phpunit": ">=10.5.62",
    "psalm/phar": "^6.0",
    "rector/rector": "^2.8",
    "squizlabs/php_codesniffer": "^4.0.1",
    "symfony/form": "^6.4",
    "symfony/stopwatch": "^6.4",
    "symfony/web-profiler-bundle": "^6.4",
    "twig/twig": "^3.26"
  },
  "config": {
    "allow-plugins": {
      "phpstan/extension-installer": true
    }
  },
  "extra": {
    "symfony": {
      "require": "6.4.*"
    }
  },
  "scripts": {
    "test": "@php Tests/run.php",
    "test:coverage": "@test --coverage-clover Tests/coverage.xml --log-junit Tests/junit.xml",
    "phpstan": "@php vendor/bin/phpstan analyse -c phpstan.dist.neon --memory-limit=1G",
    "psalm": "@php -d memory_limit=1G vendor/bin/psalm.phar --config=psalm.dist.xml",
    "phpcs": "@php vendor/bin/phpcs --standard=phpcs.dist.xml",
    "rector": "@php vendor/bin/rector process",
    "rector:check": "@rector --dry-run"
  }
}
