{
  "name": "a-gautrot/propel-bundle",
  "description": "Integration of Propel in Symfony",
  "type": "symfony-bundle",
  "license": "MIT",
  "keywords": [
    "propel",
    "orm",
    "persistence"
  ],
  "authors": [
    {
      "name": "William Durand",
      "email": "william.durand1@gmail.com",
      "role": "Author"
    },
    {
      "name": "SkyFoxvn",
      "role": "Maintenance"
    },
    {
      "name": "Alexandre Gautrot",
      "email": "alexandre.gautrot@etik.com",
      "role": "Maintenance"
    }
  ],
  "autoload": {
    "psr-4": {
      "Propel\\Bundle\\PropelBundle\\": ""
    },
    "classmap": [
      "AppBundle.php"
    ],
    "exclude-from-classmap": [
      "Tests/"
    ]
  },
  "require": {
    "php": ">=8.1",
    "ext-json": "*",
    "ext-pdo": "*",
    "ext-simplexml": "*",
    "propel/propel": "~2.0",
    "psr/log": "^3.0",
    "symfony/cache": "^6.4.38",
    "symfony/config": "^6.4",
    "symfony/console": "^6.4",
    "symfony/dependency-injection": "^6.4",
    "symfony/framework-bundle": "^6.4",
    "symfony/http-foundation": "^6.4.35",
    "symfony/http-kernel": "^6.4",
    "symfony/routing": "^6.4.40",
    "symfony/security-bundle": "^6.4.10",
    "symfony/security-core": "^6.4",
    "symfony/security-http": "^6.4.40",
    "symfony/translation": "^6.4.3",
    "symfony/validator": "^6.4.10",
    "symfony/var-exporter": "^6.4",
    "symfony/yaml": "^6.4.39"
  },
  "require-dev": {
    "ext-dom": "*",
    "ext-libxml": "*",
    "ext-pdo_sqlite": "*",
    "fakerphp/faker": "^1.24",
    "mikey179/vfsstream": "^1.6.12",
    "phpstan/extension-installer": "^1.4",
    "phpstan/phpstan": "^2.0",
    "phpstan/phpstan-deprecation-rules": "^2.0",
    "phpstan/phpstan-symfony": "^2.0",
    "phpunit/phpunit": ">=10.5.62",
    "squizlabs/php_codesniffer": "^4.0.1",
    "symfony/form": "^6.4",
    "symfony/profiler-pack": "^1.0.4",
    "symfony/stopwatch": "^6.4",
    "symfony/web-profiler-bundle": "^6.4",
    "twig/twig": "^3.26",
    "vimeo/psalm": "^6.0"
  },
  "config": {
    "allow-plugins": {
      "phpstan/extension-installer": true
    }
  },
  "extra": {
  },
  "scripts": {
    "test": "@php Tests/run.php",
    "test:coverage": "@test --coverage-clover Tests/coverage.xml --log-junit Tests/junit.xml",
    "phpstan": "vendor/bin/phpstan analyse -c phpstan.dist.neon",
    "psalm": "vendor/bin/psalm --config=psalm.dist.xml",
    "phpcs": "phpcs --standard=phpcs.dist.xml"
  }
}
