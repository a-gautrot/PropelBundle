{
  "name": "a-gautrot/propel-bundle",
  "description": "Integration of Propel in Symfony",
  "keywords": [
    "propel",
    "orm",
    "persistence"
  ],
  "type": "symfony-bundle",
  "license": "MIT",
  "authors": [
    {
      "name": "William Durand",
      "email": "william.durand1@gmail.com",
      "role": "Author"
    },
    {
      "name": "SkyFoxvn",
      "role": "Maintenance"
    },
    {
      "name": "Alexandre Gautrot",
      "email": "alexandre.gautrot@etik.com",
      "role": "Maintenance"
    }
  ],
  "autoload": {
    "psr-4": {
      "Propel\\Bundle\\PropelBundle\\": ""
    },
    "classmap": [
      "AppBundle.php"
    ],
    "exclude-from-classmap": [
      "Tests/"
    ]
  },
  "require": {
    "php": ">=7.4",
    "ext-simplexml": "*",
    "propel/propel": "~2.0.0-beta4",
    "sensio/framework-extra-bundle": "^6.2",
    "symfony/cache": "^5.4.46",
    "symfony/config": "^5.4.19",
    "symfony/console": "^5.4.19",
    "symfony/dependency-injection": "^5.4.42",
    "symfony/framework-bundle": "^5.4.19",
    "symfony/http-foundation": "^5.4.49",
    "symfony/http-kernel": "^5.4.19",
    "symfony/routing": "^5.4.52",
    "symfony/security-bundle": "^5.4.19",
    "symfony/security-core": "^5.4.19",
    "symfony/security-http": "^5.4.52",
    "symfony/translation": "^5.4.42",
    "symfony/validator": "^5.4.42",
    "symfony/var-exporter": "^v5.4.19",
    "symfony/yaml": "^5.4.51"
  },
  "require-dev": {
    "ext-dom": "*",
    "ext-json": "*",
    "ext-libxml": "*",
    "ext-pdo": "*",
    "ext-pdo_sqlite": "*",
    "fakerphp/faker": "^1.0",
    "mikey179/vfsstream": "^1.6",
    "phpstan/extension-installer": "^1.4",
    "phpstan/phpstan": "^2.0",
    "phpstan/phpstan-deprecation-rules": "^2.0",
    "phpstan/phpstan-symfony": "^2.0",
    "phpunit/phpunit": ">=9.6.33",
    "squizlabs/php_codesniffer": "^4.0.1",
    "symfony/form": "^5.4.19",
    "symfony/profiler-pack": "^1.0.4",
    "symfony/stopwatch": "^5.4.19",
    "symfony/twig-bridge": "^5.4.31",
    "symfony/web-profiler-bundle": "^5.4",
    "twig/twig": "<=3.19||^3.26",
    "vimeo/psalm": ">=5"
  },
  "config": {
    "allow-plugins": {
      "phpstan/extension-installer": true
    },
    "policy": {
      "advisories": {
        "ignore": [
          "twig/twig"
        ]
      }
    }
  },
  "extra": {
  },
  "scripts": {
    "test": "@php Tests/run.php",
    "test:coverage": "@test --coverage-clover Tests/coverage.xml --log-junit Tests/junit.xml",
    "phpstan": "vendor/bin/phpstan analyse -c phpstan.dist.neon",
    "psalm": "@php vendor/vimeo/psalm/psalm --config=psalm.dist.xml",
    "phpcs": "phpcs --standard=phpcs.dist.xml"
  }
}
