{
  "name": "a-gautrot/propel-bundle",
  "description": "Integration of Propel in Symfony",
  "type": "symfony-bundle",
  "license": "MIT",
  "keywords": [
    "propel",
    "orm",
    "persistence"
  ],
  "authors": [
    {
      "name": "William Durand",
      "email": "william.durand1@gmail.com",
      "role": "Author"
    },
    {
      "name": "SkyFoxvn",
      "role": "Maintenance"
    },
    {
      "name": "Alexandre Gautrot",
      "email": "alexandre.gautrot@etik.com",
      "role": "Maintenance"
    }
  ],
  "autoload": {
    "psr-4": {
      "Propel\\Bundle\\PropelBundle\\": ""
    },
    "classmap": [
      "AppBundle.php"
    ],
    "exclude-from-classmap": [
      "Tests/"
    ]
  },
  "require": {
    "php": ">=8.2",
    "ext-pdo": "*",
    "ext-simplexml": "*",
    "propel/propel": "~2.0",
    "psr/log": "^3.0",
    "symfony/config": "^7.4",
    "symfony/console": "^7.4",
    "symfony/dependency-injection": "^7.4",
    "symfony/framework-bundle": "^7.4",
    "symfony/http-foundation": "^7.4",
    "symfony/http-kernel": "^7.4",
    "symfony/security-bundle": "^7.4",
    "symfony/security-core": "^7.4",
    "symfony/validator": "^7.4",
    "symfony/yaml": "^7.4"
  },
  "conflict": {
    "symfony/cache": "<7.4||>=8.0",
    "symfony/clock": "<7.4||>=8.0",
    "symfony/error-handler": "<7.4||>=8.0",
    "symfony/event-dispatcher": "<7.4||>=8.0",
    "symfony/filesystem": "<7.4||>=8.0",
    "symfony/finder": "<7.4||>=8.0",
    "symfony/options-resolver": "<7.4||>=8.0",
    "symfony/password-hasher": "<7.4||>=8.0",
    "symfony/property-access": "<7.4||>=8.0",
    "symfony/property-info": "<7.4||>=8.0",
    "symfony/routing": "<7.4||>=8.0",
    "symfony/security-csrf": "<7.4||>=8.0",
    "symfony/security-http": "<7.4||>=8.0",
    "symfony/string": "<7.4||>=8.0",
    "symfony/translation": "<7.4.3||>=8.0",
    "symfony/twig-bridge": "<7.4||>=8.0",
    "symfony/twig-bundle": "<7.4||>=8.0",
    "symfony/var-dumper": "<7.4||>=8.0",
    "symfony/var-exporter": "<7.4||>=8.0"
  },
  "require-dev": {
    "ext-dom": "*",
    "ext-libxml": "*",
    "ext-pdo_sqlite": "*",
    "fakerphp/faker": "^1.24",
    "mikey179/vfsstream": "^1.6.12",
    "phpstan/extension-installer": "^1.4",
    "phpstan/phpstan": "^2.0",
    "phpstan/phpstan-deprecation-rules": "^2.0",
    "phpstan/phpstan-symfony": "^2.0",
    "phpunit/phpunit": ">=11.5.50",
    "psalm/phar": "^6.0",
    "rector/rector": "^2.8",
    "squizlabs/php_codesniffer": "^4.0.1",
    "symfony/form": "^7.4",
    "symfony/stopwatch": "^7.4",
    "symfony/web-profiler-bundle": "^7.4",
    "twig/twig": "^3.26"
  },
  "config": {
    "allow-plugins": {
      "phpstan/extension-installer": true
    }
  },
  "extra": {
    "symfony": {
      "require": "7.4.*"
    }
  },
  "scripts": {
    "test": "@php Tests/run.php",
    "test:coverage": "@test --coverage-clover Tests/coverage.xml --log-junit Tests/junit.xml",
    "phpstan": "vendor/bin/phpstan analyse -c phpstan.dist.neon",
    "psalm": "vendor/bin/psalm --config=psalm.dist.xml",
    "phpcs": "phpcs --standard=phpcs.dist.xml"
  }
}
