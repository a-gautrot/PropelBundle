{
  "name": "a-gautrot/propel-bundle",
  "description": "Integration of Propel in Symfony",
  "type": "symfony-bundle",
  "license": "MIT",
  "keywords": [
    "propel",
    "orm",
    "persistence"
  ],
  "authors": [
    {
      "name": "William Durand",
      "email": "william.durand1@gmail.com",
      "role": "Author"
    },
    {
      "name": "SkyFoxvn",
      "role": "Maintenance"
    },
    {
      "name": "Alexandre Gautrot",
      "email": "alexandre.gautrot@etik.com",
      "role": "Maintenance"
    }
  ],
  "autoload": {
    "psr-4": {
      "Propel\\Bundle\\PropelBundle\\": ""
    },
    "classmap": [
      "AppBundle.php"
    ],
    "exclude-from-classmap": [
      "Tests/"
    ]
  },
  "repositories": [
    {
      "type": "package",
      "package": {
        "name": "propel/propel",
        "version": "2.0.1",
        "type": "library",
        "license": "MIT",
        "source": {
          "type": "git",
          "url": "https://github.com/propelorm/Propel2.git",
          "reference": "92d27b41f5d510a04d0fe052a7add502ac95bbc9"
        },
        "require": {
          "php": ">=8.0",
          "psr/log": "^1.0 || ^2.0 || ^3.0",
          "symfony/config": "^8.1",
          "symfony/console": "^8.1",
          "symfony/filesystem": "^8.1",
          "symfony/finder": "^8.1",
          "symfony/translation": "^8.1",
          "symfony/validator": "^8.1",
          "symfony/yaml": "^8.1"
        },
        "autoload": {
          "psr-4": {
            "Propel\\": "src/Propel/"
          }
        },
        "bin": [
          "bin/propel"
        ]
      }
    }
  ],
  "require": {
    "php": ">=8.4",
    "ext-pdo": "*",
    "ext-simplexml": "*",
    "propel/propel": "~2.0",
    "psr/log": "^3.0",
    "symfony/config": "^8.1",
    "symfony/console": "^8.1",
    "symfony/dependency-injection": "^8.1",
    "symfony/framework-bundle": "^8.1",
    "symfony/http-foundation": "^8.1",
    "symfony/http-kernel": "^8.1",
    "symfony/polyfill-php85": "^1.33",
    "symfony/security-bundle": "^8.1",
    "symfony/security-core": "^8.1",
    "symfony/validator": "^8.1",
    "symfony/yaml": "^8.1"
  },
  "conflict": {
    "symfony/cache": "<8.1||>=9.0",
    "symfony/clock": "<8.1||>=9.0",
    "symfony/error-handler": "<8.1||>=9.0",
    "symfony/event-dispatcher": "<8.1||>=9.0",
    "symfony/filesystem": "<8.1||>=9.0",
    "symfony/finder": "<8.1||>=9.0",
    "symfony/options-resolver": "<8.1||>=9.0",
    "symfony/password-hasher": "<8.1||>=9.0",
    "symfony/property-access": "<8.1||>=9.0",
    "symfony/property-info": "<8.1||>=9.0",
    "symfony/routing": "<8.1||>=9.0",
    "symfony/security-csrf": "<8.1||>=9.0",
    "symfony/security-http": "<8.1||>=9.0",
    "symfony/string": "<8.1||>=9.0",
    "symfony/translation": "<8.1||>=9.0",
    "symfony/twig-bridge": "<8.1||>=9.0",
    "symfony/twig-bundle": "<8.1||>=9.0",
    "symfony/var-dumper": "<8.1||>=9.0",
    "symfony/var-exporter": "<8.1||>=9.0"
  },
  "require-dev": {
    "ext-dom": "*",
    "ext-libxml": "*",
    "ext-pdo_sqlite": "*",
    "fakerphp/faker": "^1.24",
    "mikey179/vfsstream": "^1.6.12",
    "phpstan/extension-installer": "^1.4",
    "phpstan/phpstan": "^2.0",
    "phpstan/phpstan-deprecation-rules": "^2.0",
    "phpstan/phpstan-symfony": "^2.0",
    "phpunit/phpunit": ">=13.1.6",
    "psalm/phar": "^6.0",
    "rector/rector": "^2.8",
    "squizlabs/php_codesniffer": "^4.0.1",
    "symfony/form": "^8.1",
    "symfony/stopwatch": "^8.1",
    "symfony/web-profiler-bundle": "^8.1",
    "twig/twig": "^3.26"
  },
  "config": {
    "allow-plugins": {
      "phpstan/extension-installer": true
    }
  },
  "extra": {
    "symfony": {
      "require": "8.1.*"
    }
  },
  "scripts": {
    "test": "@php Tests/run.php",
    "test:coverage": "@test --coverage-clover Tests/coverage.xml --log-junit Tests/junit.xml",
    "phpstan": "@php vendor/bin/phpstan analyse -c phpstan.dist.neon --memory-limit=1G",
    "psalm": "@php -d memory_limit=1G vendor/bin/psalm.phar --config=psalm.dist.xml",
    "phpcs": "@php vendor/bin/phpcs --standard=phpcs.dist.xml",
    "rector": "@php vendor/bin/rector process",
    "rector:check": "@rector --dry-run"
  }
}
