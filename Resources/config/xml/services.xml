<?xml version="1.0" ?>

<container xmlns="http://symfony.com/schema/dic/services"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://symfony.com/schema/dic/services https://symfony.com/schema/dic/services/services-1.0.xsd">

    <services>
        <defaults autowire="true" autoconfigure="true" public="false" />

        <prototype namespace="Propel\Bundle\PropelBundle\" resource="../../../*">
            <exclude>../../../{Console,Propel,Model,Migrations,Tests,Helpers,DependencyInjection,Form,Listener,Validator,Resources/config,Resources/skeleton,Twig/Extension/SyntaxExtension.php,DataCollector,AppBundle.php,vendor}</exclude>
        </prototype>

        <service id="Symfony\Component\DependencyInjection\ContainerInterface" alias="service_container" />
    </services>
</container>
