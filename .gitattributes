# Normalize text files to LF
* text=auto eol=lf
*.stub text
*.stubphp text
*.bat text eol=crlf
*.cmd text eol=crlf

# Exclude development files from distribution archives
/.gitattributes export-ignore
/.gitignore export-ignore
/.github export-ignore
/.travis.yml export-ignore
/codecov.yaml export-ignore
/phpcs.dist.xml export-ignore
/phpcs.dist.xsd export-ignore
/phpstan.dist.neon export-ignore
/phpstan-baseline.neon export-ignore
/phpunit.dist.xml export-ignore
/psalm.dist.xml export-ignore
/psalm-baseline.xml export-ignore
/Resources/phpstan export-ignore
/Resources/psalm export-ignore
/Tests export-ignore
/CHANGELOG.md export-ignore
/rector.php export-ignore
